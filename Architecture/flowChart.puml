@startuml
title MCP Banking API - Activity Flow

start

:AI Agent sends POST /mcp request;

:ASGI receives request at /mcp endpoint;

if (MCP_AUTH_TOKEN configured?) then (yes)
  if (Authorization header valid?) then (yes)
    :MCPAuthMiddleware authorizes request;
  else (no)
    :Return 401 Unauthorized;
    stop
  endif
else (no)
  :Skip authentication;
endif

:FastMCP HTTP handler processes request;

:Identify and dispatch requested tool;

fork
  :Start Langfuse trace observation;
fork again
  :Execute tool handler;
end fork

note right
  Tool execution diverges here
  based on which tool was requested
end note

partition "Tool-Specific Execution" {
  if (Tool = run_automation_maven_tests?) then (yes)
    :Resolve Maven command path;
    :Resolve test suite path;
    :Execute Maven subprocess\nin automation_mvn_tests/ directory;
    :Capture stdout/stderr output;
    :Parse test reports;
    :Format results as JSON;
  else (no - banking tools)
    :Build httpx request;
    :Determine target endpoint\n(/api/v1/customers or\n/api/v1/customers/{id}/accounts);
    :Send HTTP request to\nlocal FastAPI server;
    :Receive HTTP response;
    :Extract response data;
  endif
}

:Tool returns result;

fork
  :Complete Langfuse observation;
fork again
  :Format tool result for MCP protocol;
end fork

:Return JSON response to AI Agent;

stop
@enduml