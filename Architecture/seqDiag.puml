@startuml
title MCP Banking API - Sequence Flow

skinparam {
  sequenceMessageAlign center
  BoxPadding 10
  ParticipantPadding 20
  ArrowThickness 2
}

actor "AI Agent" as AI
participant "MCP Endpoint\n/mcp" as MCP
participant "Auth Middleware" as AUTH
participant "FastMCP Server" as SERVER
participant "Tool Handler\n(create_customer)" as TOOL
participant "Langfuse" as OBS
participant "httpx Client" as HTTP
participant "REST API\n/api/v1/customers" as REST
participant "Pydantic Models" as MOD
database "customer_store" as DB

== MCP Tool Call Flow ==

AI -> MCP : POST /mcp\n{"tool": "create_customer",\n"params": {...}}
activate MCP

MCP -> AUTH : Check MCP_AUTH_TOKEN
activate AUTH
AUTH --> MCP : ✓ Authorized
deactivate AUTH

MCP -> SERVER : Route to tool
activate SERVER

SERVER -> TOOL : Invoke create_customer
activate TOOL

TOOL -> OBS : Trace start
activate OBS
OBS --> TOOL : ✓ Logged
deactivate OBS

TOOL -> HTTP : POST http://localhost/api/v1/customers\n{"name": "John", "ssn": "***"}
activate HTTP

HTTP -> REST : Forward request
activate REST

REST -> MOD : Validate with Pydantic schema
activate MOD
MOD --> REST : ✓ Valid
deactivate MOD

REST -> DB : Create customer record
activate DB
DB --> REST : Customer ID: 12345
deactivate DB

REST --> HTTP : 201 Created\n{"id": 12345, "name": "John"}
deactivate REST

HTTP --> TOOL : Response
deactivate HTTP

TOOL -> OBS : Trace complete (with redaction)
activate OBS
OBS --> TOOL : ✓ Logged
deactivate OBS

TOOL --> SERVER : Success result
deactivate TOOL

SERVER --> MCP : Tool result
deactivate SERVER

MCP --> AI : 200 OK\n{"result": {...}}
deactivate MCP

@enduml